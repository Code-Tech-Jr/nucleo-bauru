# Copie para .env.local e preencha. O .env.local não vai pro git.
# NÃO COLOQUE NENHUM TOKEN AQUI — os valores reais ficam só no .env.local

# Chave da API do Resend (https://resend.com/api-keys) — permissão de envio basta
# TODO(resend): preencher no .env.local e no painel da Vercel
RESEND_API_KEY=

# Remetente. Precisa ser de um domínio verificado no Resend.
# Para testar sem domínio verificado, use: Núcleo Bauru <onboarding@resend.dev>
# (nesse modo o Resend só entrega para o e-mail dono da conta)
# TODO(resend): preencher no .env.local e no painel da Vercel
CONTATO_EMAIL_FROM=Núcleo Bauru <nao-responda@nucleobauru.com.br>

# Caixa que recebe os contatos do site.
# Se não definir, cai no EMAIL de src/lib/site.ts
# TODO(resend): preencher no .env.local e no painel da Vercel
CONTATO_EMAIL_TO=presidencia@nucleobauru.com.br

# URL de export CSV da planilha de EJs publicada na web
# (na planilha: Arquivo → Compartilhar → Publicar na web → CSV)
# Sem essa variável o site sobe com os números de fallback do NossaRedeStats.
EJS_SHEET_CSV_URL=

# URL de export CSV da aba "Noticias e Eventos" da mesma planilha
# (na planilha: Arquivo → Compartilhar → Publicar na web → aba "Noticias e Eventos" → CSV)
# Sem essa variável a seção "Eventos e Notícias" da Home não aparece.
NOTICIAS_SHEET_CSV_URL=

# Domínio público do site, usado no canonical e no og:url das notícias.
# Sem ele o metadataBase cai no fallback de src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=
