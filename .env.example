# URL de export CSV da planilha de EJs publicada na web
# (na planilha: Arquivo → Compartilhar → Publicar na web → CSV)
# Sem essa variável o site sobe com os números de fallback do NossaRedeStats.
#NÃO COLOCAR NENHUM TOKEN AQUI CRIE UM .env.local e copie os nomes presentes nesse arquivo e coloque os tokens la
EJS_SHEET_CSV_URL=

# URL de export CSV da aba "Noticias e Eventos" da mesma planilha
# (na planilha: Arquivo → Compartilhar → Publicar na web → aba "Noticias e Eventos" → CSV)
# Sem essa variável a seção "Eventos e Notícias" da Home não aparece.
NOTICIAS_SHEET_CSV_URL=

# Domínio público do site, usado no canonical e no og:url das notícias.
# Sem ele o metadataBase cai no fallback de src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=
